{
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "port": __PORT__,
      "protocol": "vless",
      "settings": {
        "clients": [{ "id": "__UUID__" }],
        "decryption": "none"
      },
      "streamSettings": {
